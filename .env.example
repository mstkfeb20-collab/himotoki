# Copy to .env and fill in.
# Required: token for the API and viewer (open the viewer once as http://host:8765/?token=<value>)
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HIMOTOKI_API_TOKEN=
# Host names clients use to reach the server (comma separated)
HIMOTOKI_ALLOWED_HOSTS=localhost,127.0.0.1
ANTHROPIC_API_KEY=
HIMOTOKI_LLM_MODEL=claude-sonnet-5-5
NEO4J_PASSWORD=change-me
# Folder on the host that contains the repositories (mounted read-only at /repos)
REPOS_DIR=./repos
# Folder with your own rule packs (YAML) for in-house frameworks
RULES_DIR=./samples/rules
# Code search used for the cross-search phase (default: git grep in the checkout)
HIMOTOKI_CODESEARCH=
# Webhook from GitLab/GitHub: shared secret, and tokens to post the impact comment
HIMOTOKI_WEBHOOK_SECRET=
GITLAB_API=
GITLAB_TOKEN=
GITHUB_TOKEN=
