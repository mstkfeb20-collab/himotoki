# Copy to .env and fill in.
ANTHROPIC_API_KEY=
IMPACT_LLM_MODEL=claude-sonnet-5-5
NEO4J_PASSWORD=impact-dev-password
# Folder on the host that contains the repositories (mounted read-only at /repos)
REPOS_DIR=./repos
# Folder with your own rule packs (YAML) for in-house frameworks
RULES_DIR=./samples/rules
# Code search used for the cross-search phase (default: git grep in the checkout)
IMPACT_CODESEARCH=
# Webhook from GitLab/GitHub: shared secret, and tokens to post the impact comment
IMPACT_WEBHOOK_SECRET=
GITLAB_API=
GITLAB_TOKEN=
GITHUB_TOKEN=
