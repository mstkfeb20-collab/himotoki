<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.2">
  <enterprise-beans>
    <session>
      <ejb-name>OrderServiceBean</ejb-name>
      <ejb-class>com.example.order.ejb.OrderServiceBean</ejb-class>
      <session-type>Stateless</session-type>
      <transaction-type>Container</transaction-type>
    </session>
  </enterprise-beans>
  <assembly-descriptor>
    <!-- 取消は呼び出し元とは独立にコミットする（運用で決めた） -->
    <container-transaction>
      <method>
        <ejb-name>OrderServiceBean</ejb-name>
        <method-name>cancelOrder</method-name>
      </method>
      <trans-attribute>RequiresNew</trans-attribute>
    </container-transaction>
  </assembly-descriptor>
</ejb-jar>
