<?xml version="1.0" encoding="UTF-8"?>
<struts-config>
  <form-beans>
    <form-bean name="ShohinForm" type="jp.co.acme.web.ShohinForm"/>
    <form-bean name="KensakuForm" type="org.apache.struts.validator.DynaValidatorForm">
      <form-property name="shohinNm" type="java.lang.String"/>
    </form-bean>
  </form-beans>
  <action-mappings>
    <action path="/shohin/regist" type="jp.co.acme.web.ShohinRegistAction" name="ShohinForm"
            input="/WEB-INF/jsp/ABCG010.jsp" scope="request" validate="true">
      <forward name="success" path="/WEB-INF/jsp/ABCG011.jsp"/>
    </action>
    <action path="/shohin/kensaku" type="jp.co.acme.web.ShohinKensakuAction" name="KensakuForm"/>
  </action-mappings>
</struts-config>
