{
  "_note": "レビュー役（Claude）が候補一覧とコードを確認して下した判断。上から順に最初に一致したルールを適用する（fnmatch）。最後の * は、個別に確認したうえで無関係と判断した残りをまとめて除外するもの。",
  "R1": [
    {"match": "java:org.springframework.samples.petclinic.owner.Owner", "status": "confirmed", "reason": "email フィールドと getter/setter、入力チェック注釈を追加"},
    {"match": "java:org.springframework.samples.petclinic.owner.Owner#toString()", "status": "confirmed", "reason": "toString に email を追加（既存項目はすべて出力している）"},
    {"match": "table:owners", "status": "confirmed", "reason": "email 列を追加"},
    {"match": "file:src/main/resources/db/*/schema.sql", "status": "confirmed", "reason": "3DBMSすべての CREATE TABLE owners に email 列を追加"},
    {"match": "file:src/main/resources/db/h2/data.sql", "status": "confirmed", "reason": "列名なしINSERT（列順依存）のため値を追加しないと初期化に失敗する"},
    {"match": "file:src/main/resources/db/mysql/data.sql", "status": "confirmed", "reason": "列名なしINSERT（列順依存）のため値を追加しないと初期化に失敗する"},
    {"match": "file:src/main/resources/db/postgres/data.sql", "status": "excluded", "reason": "列名を指定したINSERTのため、email をNULL許容にすれば修正不要"},
    {"match": "tpl:owners/createOrUpdateOwnerForm", "status": "confirmed", "reason": "メールアドレスの入力欄を追加"},
    {"match": "tpl:owners/ownerDetails", "status": "confirmed", "reason": "要求どおり詳細画面にメールアドレスを表示"},
    {"match": "tpl:owners/ownersList", "status": "excluded", "reason": "要求は詳細画面への表示のみ。一覧には出さない"},
    {"match": "file:src/main/resources/messages/messages*.properties", "status": "confirmed", "reason": "email の表示ラベルを全ロケールに追加（I18nPropertiesSyncTest がキーの同期を検査）"},
    {"match": "doc:design:画面設計_オーナー登録.md#2", "status": "confirmed", "reason": "入力項目表にメールアドレスを追記"},
    {"match": "doc:design:画面設計_オーナー詳細.md#2", "status": "confirmed", "reason": "表示項目表にメールアドレスを追記"},
    {"match": "doc:design:テーブル定義_owners.md#0", "status": "confirmed", "reason": "列定義に owners.email を追記"},
    {"match": "doc:design:画面設計_オーナー登録.md#3", "status": "excluded", "reason": "要求に形式チェックの指定なし。@Email を付ける場合は追記が必要（要確認事項として記録）"},
    {"match": "doc:*", "status": "excluded", "reason": "概要・遷移・ペット/獣医の記述でメールアドレス追加の影響なし"},
    {"match": "*OwnerControllerTests#george()", "status": "confirmed", "reason": "テスト用オーナーに email を設定"},
    {"match": "*OwnerControllerTests#processCreationFormSuccess()", "status": "confirmed", "reason": "email を含む登録成功ケースに更新"},
    {"match": "*OwnerControllerTests#processUpdateOwnerFormSuccess()", "status": "confirmed", "reason": "email を含む更新成功ケースに更新"},
    {"match": "*OwnerControllerTests#showOwner()", "status": "confirmed", "reason": "詳細表示で email を検証"},
    {"match": "*ClinicServiceTests#shouldInsertOwner()", "status": "confirmed", "reason": "DB登録時に email が保存されることを検証"},
    {"match": "ep:GET /owners/new", "status": "confirmed", "reason": "登録画面の表示内容が変わる"},
    {"match": "ep:POST /owners/new", "status": "confirmed", "reason": "登録で受け取る項目が増える"},
    {"match": "ep:*/owners/{ownerId}/edit", "status": "confirmed", "reason": "更新画面・更新処理の項目が増える"},
    {"match": "ep:GET /owners/{ownerId}", "status": "confirmed", "reason": "詳細画面の表示内容が変わる"},
    {"match": "ep:*", "status": "excluded", "reason": "検索・ペット関連のエンドポイントで、オーナーの項目追加の影響なし"},
    {"match": "*owner.OwnerController#*", "status": "excluded", "reason": "Owner へのデータバインドで自動的に受け渡されるためコントローラの修正は不要"},
    {"match": "*Owner.telephone", "status": "excluded", "reason": "既存の電話番号は変更しない（類似項目として参考にしただけ）"},
    {"match": "*Owner#?etTelephone*", "status": "excluded", "reason": "既存の電話番号は変更しない"},
    {"match": "col:owners.telephone", "status": "excluded", "reason": "既存列は変更しない"},
    {"match": "msg:*", "status": "excluded", "reason": "既存のラベル・メッセージは変更しない"},
    {"match": "*", "status": "excluded", "reason": "ペット・診察・検索・語の一致のみで、メールアドレス追加の影響なしと確認"}
  ],
  "R2": [
    {"match": "*owner.Owner.telephone", "status": "confirmed", "reason": "@Pattern の正規表現を \\d{10,11} に変更"},
    {"match": "msg:telephone.invalid", "status": "confirmed", "reason": "エラーメッセージの「10桁」を全ロケールで「10〜11桁」に変更"},
    {"match": "file:src/main/resources/messages/messages*.properties", "status": "confirmed", "reason": "telephone.invalid の文言を各ロケールファイルで修正"},
    {"match": "doc:design:画面設計_オーナー登録.md#3", "status": "confirmed", "reason": "入力チェックの記述を10〜11桁に変更"},
    {"match": "doc:design:画面設計_オーナー登録.md#2", "status": "confirmed", "reason": "入力項目表の桁数・形式を変更"},
    {"match": "*OwnerControllerTests#processCreationFormHasErrors()", "status": "confirmed", "reason": "12桁・9桁が不正になるケースを追加"},
    {"match": "*OwnerControllerTests#processUpdateOwnerFormHasErrors()", "status": "confirmed", "reason": "更新時の不正桁数ケースを追加"},
    {"match": "*OwnerControllerTests#processCreationFormSuccess()", "status": "confirmed", "reason": "11桁で登録できるケースを追加"},
    {"match": "col:owners.telephone", "status": "excluded", "reason": "列長 VARCHAR(20) で11桁を格納できる"},
    {"match": "file:src/main/resources/db/*", "status": "excluded", "reason": "列長20のままで十分。既存データは10桁で新ルールでも有効"},
    {"match": "table:owners", "status": "excluded", "reason": "テーブル定義の変更なし"},
    {"match": "doc:*", "status": "excluded", "reason": "列長・表示項目・遷移の記述は桁数チェック変更の影響なし"},
    {"match": "tpl:*", "status": "excluded", "reason": "入力欄・表示は桁数に依存しない"},
    {"match": "msg:*", "status": "excluded", "reason": "ラベル文言（電話番号・なし）は変更しない"},
    {"match": "*", "status": "excluded", "reason": "getter/setter・ペット検証・その他テスト・語の一致のみで影響なしと確認"}
  ],
  "R3": [
    {"match": "*vet.VetController#findPaginated(int)", "status": "confirmed", "reason": "pageSize を 5 から 10 に変更"},
    {"match": "doc:design:画面設計_獣医一覧.md#2", "status": "confirmed", "reason": "ページングの記述を「1ページあたり10件」に変更"},
    {"match": "ep:GET /vets.html", "status": "confirmed", "reason": "獣医一覧画面の表示件数が変わる"},
    {"match": "*vet.VetController#showVetList*", "status": "excluded", "reason": "ページ番号の範囲チェックは件数に依存しない"},
    {"match": "*vet.VetController#addPaginationModel*", "status": "excluded", "reason": "モデルへの詰め替えのみで件数に依存しない"},
    {"match": "tpl:vets/vetList", "status": "excluded", "reason": "ページ送りは totalPages から描画しており件数に依存しない"},
    {"match": "*VetControllerTests*", "status": "excluded", "reason": "リポジトリをモックした PageImpl を返すためページサイズに依存しない"},
    {"match": "*OwnerController*", "status": "excluded", "reason": "オーナー検索のページング（同じく5件）は要求の対象外"},
    {"match": "*", "status": "excluded", "reason": "獣医データ構造・ラベル・SQL・語の一致のみで、表示件数の変更の影響なしと確認"}
  ]
}
